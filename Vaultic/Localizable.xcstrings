    "These codes will be permanently removed from this device. This cannot be undone.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diese Codes werden endgültig von diesem Gerät entfernt. Das kann nicht rückgängig gemacht werden."
          }
        },
        "es-ES": {
          "stringUnit": {
