    "Restoring will replace all current tokens with the backup. Tokens that aren't in the backup move to Recently Deleted.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Wiederherstellen werden alle aktuellen Codes durch die Sicherung ersetzt. Codes, die nicht in der Sicherung sind, werden nach „Zuletzt gelöscht“ verschoben."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Al restaurar se reemplazarán todos los códigos actuales por los de la copia. Los códigos que no estén en la copia pasarán a Eliminados recientemente."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "La restauration remplacera tous les codes actuels par ceux de la sauvegarde. Les codes absents de la sauvegarde seront déplacés dans Supprimés récemment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元すると現在のコードはすべてバックアップの内容に置き換わります。バックアップにないコードは「最近削除した項目」に移動します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A restauração substituirá todos os códigos atuais pelos do backup. Os códigos que não estiverem no backup irão para Excluídos recentemente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复会用备份中的账户替换当前全部账户。备份中没有的账户会移到“最近删除”。"
          }
        }
      }
    },
