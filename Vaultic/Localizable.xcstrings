    "Tip: You can also scan this with your iPhone camera": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp: Sie können ihn auch mit der iPhone-Kamera scannen"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Consejo: también puedes escanearlo con la cámara del iPhone"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Astuce : vous pouvez aussi le scanner avec l'appareil photo de votre iPhone"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヒント: iPhone のカメラでも読み取れます"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dica: você também pode escanear com a câmera do iPhone"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：也可以用 iPhone 相机扫描"
          }
        }
      }
    },
    "To scan QR codes, please allow camera access": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie den Kamerazugriff, um QR-Codes zu scannen"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Para escanear códigos QR, permite el acceso a la cámara"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour scanner des QR codes, autorisez l'accès à la caméra"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "QR コードを読み取るには、カメラへのアクセスを許可してください"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para escanear QR codes, permita o acesso à câmera"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要扫描二维码，请允许访问相机"
          }
        }
      }
    },
    "Token details": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Code-Details"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Detalles del código"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
