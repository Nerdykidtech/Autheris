    },
    "Tokens stay on this device either way. Deleting from iCloud also removes them from your other devices.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Codes bleiben in jedem Fall auf diesem Gerät. Beim Löschen aus iCloud werden sie auch von Ihren anderen Geräten entfernt."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los códigos se quedan en este dispositivo en cualquier caso. Si los eliminas de iCloud, también desaparecen de tus otros dispositivos."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dans tous les cas, les codes restent sur cet appareil. Les supprimer d'iCloud les retire aussi de vos autres appareils."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "どちらの場合も、コードはこの端末に残ります。iCloud から削除すると、ほかの端末からも消えます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De qualquer forma, os códigos ficam neste dispositivo. Excluir do iCloud também os remove dos seus outros dispositivos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "无论哪种方式，账户都会留在本设备上。从 iCloud 删除也会把它们从你的其他设备上移除。"
          }
        }
      }
