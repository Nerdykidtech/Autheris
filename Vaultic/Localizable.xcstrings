    },
    "This backup is encrypted. Enter the password used when it was created.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diese Sicherung ist verschlüsselt. Geben Sie das Passwort ein, das beim Erstellen verwendet wurde."
          }
        },
        "es-ES": {
