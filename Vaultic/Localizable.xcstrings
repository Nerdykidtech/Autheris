    "Enter the same setup key you received when enabling two-factor authentication — or paste the setup link, if that is what the service gave you.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie denselben Einrichtungsschlüssel ein, den Sie beim Aktivieren der Zwei-Faktor-Authentifizierung erhalten haben – oder fügen Sie den Einrichtungslink ein, falls der Dienst Ihnen einen gegeben hat."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce la misma clave de configuración que recibiste al activar la autenticación en dos pasos, o pega el enlace de configuración si es lo que te dio el servicio."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez la même clé de configuration que celle reçue lors de l'activation de la validation en deux étapes — ou collez le lien de configuration si le service vous en a fourni un."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2 段階認証を有効にしたときに受け取った設定キーを入力してください。サービスが設定リンクを発行した場合は、そのリンクを貼り付けてもかまいません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite a mesma chave de configuração que você recebeu ao ativar a verificação em duas etapas — ou cole o link de configuração, caso seja o que o serviço forneceu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入启用两步验证时收到的设置密钥——如果服务提供的是设置链接，也可以直接粘贴链接。"
          }
        }
      }
    },
