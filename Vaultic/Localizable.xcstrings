    "No sign-up, no tracking, no ads. Just a focused 2FA manager that respects your privacy.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Keine Anmeldung, kein Tracking, keine Werbung. Nur ein fokussierter 2FA-Manager, der Ihre Privatsphäre respektiert."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sin registro, sin rastreo y sin anuncios. Solo un gestor 2FA centrado en respetar tu privacidad."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sans inscription, sans suivi, sans publicité. Juste un gestionnaire 2FA concentré sur le respect de votre vie privée."
