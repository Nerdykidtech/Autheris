    },
    "Your edits to this setup key have not been saved.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Änderungen an diesem Einrichtungsschlüssel wurden nicht gesichert."
