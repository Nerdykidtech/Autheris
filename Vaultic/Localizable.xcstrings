    "Encrypted Aegis exports aren't supported yet. Export an unencrypted Aegis vault instead.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschlüsselte Aegis-Exporte werden noch nicht unterstützt. Exportieren Sie stattdessen einen unverschlüsselten Aegis-Tresor."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Las exportaciones cifradas de Aegis aún no son compatibles. Exporta en su lugar una bóveda Aegis sin cifrar."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Les exports Aegis chiffrés ne sont pas encore pris en charge. Exportez plutôt un coffre Aegis non chiffré."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗号化された Aegis エクスポートはまだ対応していません。代わりに暗号化されていない Aegis ボルトをエクスポートしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportações criptografadas do Aegis ainda não são compatíveis. Exporte um cofre Aegis não criptografado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚不支持加密的 Aegis 导出。请改为导出未加密的 Aegis 保险库。"
          }
        }
      }
    },
