    "Autheris": {
      "shouldTranslate": false
    },
    "Autheris can't read your codes from the Keychain right now. They haven't been changed, and nothing will be saved until they can be read.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Autheris kann Ihre Codes gerade nicht aus dem Schlüsselbund lesen. Sie wurden nicht verändert, und es wird nichts gespeichert, bis sie wieder gelesen werden können."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Autheris no puede leer tus códigos del llavero en este momento. No se han modificado y no se guardará nada hasta que se puedan leer."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Autheris ne peut pas lire vos codes depuis le trousseau pour le moment. Ils n'ont pas été modifiés, et rien ne sera enregistré tant qu'ils ne pourront pas être lus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Autheris は現在キーチェーンからコードを読み取れません。コードは変更されておらず、読み取れるようになるまで何も保存されません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Autheris não consegue ler seus códigos das Chaves no momento. Eles não foram alterados, e nada será salvo até que possam ser lidos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Autheris 目前无法从钥匙串读取你的验证码。它们没有被更改，在能够读取之前不会保存任何内容。"
          }
        }
      }
    },
    "Autheris can't read your iCloud data yet: the CloudKit schema needs a Queryable index on recordName (CloudKit Console → Schema → Indexes).": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Autheris kann deine iCloud-Daten noch nicht lesen: Das CloudKit-Schema benötigt einen Queryable-Index für recordName (CloudKit Console → Schema → Indexes)."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Autheris aún no puede leer tus datos de iCloud: el esquema de CloudKit necesita un índice Queryable en recordName (CloudKit Console → Schema → Indexes)."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Autheris ne peut pas encore lire vos données iCloud : le schéma CloudKit doit avoir un index Queryable sur recordName (CloudKit Console → Schema → Indexes)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Autheris はまだ iCloud データを読み取れません。CloudKit スキーマの recordName に Queryable インデックスが必要です（CloudKit Console → Schema → Indexes）。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Autheris ainda não consegue ler seus dados do iCloud: o esquema do CloudKit precisa de um índice Queryable em recordName (CloudKit Console → Schema → Indexes)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Autheris 暂时无法读取你的 iCloud 数据：CloudKit 架构需要在 recordName 上添加 Queryable 索引（CloudKit Console → Schema → Indexes）。"
          }
        }
      }
    },
