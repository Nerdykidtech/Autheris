    "App Lock needs a passcode or password on this device to unlock Autheris. Set one up, then turn App Lock on again.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App-Sperre braucht einen Code oder ein Passwort auf diesem Gerät, um Autheris zu entsperren. Richten Sie eines ein und schalten Sie die App-Sperre dann erneut ein."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El bloqueo de la app necesita un código o una contraseña en este dispositivo para desbloquear Autheris. Configura uno y vuelve a activar el bloqueo de la app."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Le verrouillage de l'app nécessite un code ou un mot de passe sur cet appareil pour déverrouiller Autheris. Configurez-en un, puis réactivez le verrouillage de l'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリロックで Autheris のロックを解除するには、この端末にパスコードまたはパスワードが必要です。設定してから、もう一度アプリロックをオンにしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O bloqueio do app precisa de um código ou uma senha neste dispositivo para desbloquear o Autheris. Configure um e ative o bloqueio do app novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 锁定需要此设备设置了密码才能解锁 Autheris。请先设置密码，然后再次开启 App 锁定。"
          }
        }
      }
