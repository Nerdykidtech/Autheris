          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件不是有效的 Autheris 加密备份。"
          }
        }
      }
    },
    "This token was deleted on another device, so your changes weren't saved.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Token wurde auf einem anderen Gerät gelöscht, daher wurden deine Änderungen nicht gespeichert."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Este token se eliminó en otro dispositivo, así que tus cambios no se guardaron."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce jeton a été supprimé sur un autre appareil ; vos modifications n’ont donc pas été enregistrées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このトークンはほかのデバイスで削除されたため、変更は保存されませんでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este token foi excluído em outro dispositivo, então suas alterações não foram salvas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此令牌已在另一台设备上删除，因此你的更改未保存。"
          }
        }
      }
    },
    "Time-based (TOTP)": {
      "localizations": {
