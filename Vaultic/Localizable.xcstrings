    "Add accounts in seconds by scanning the same QR code you'd use with Google Authenticator.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fügen Sie Konten in Sekunden hinzu, indem Sie denselben QR-Code scannen, den Sie mit Google Authenticator verwenden würden."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Añade cuentas en segundos escaneando el mismo código QR que usarías con Google Authenticator."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ajoutez des comptes en quelques secondes en scannant le même QR code que celui utilisé avec Google Authenticator."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Google Authenticator で使うのと同じ QR コードを読み取るだけで、数秒でアカウントを追加できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Adicione contas em segundos escaneando o mesmo QR code que você usaria no Google Authenticator."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "扫描与 Google Authenticator 相同的二维码，几秒内即可添加账户。"
          }
        }
      }
    },
