    "Will retry automatically. Changes are saved on this device.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird automatisch erneut versucht. Änderungen werden auf diesem Gerät gespeichert."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Se reintentará automáticamente. Los cambios se guardan en este dispositivo."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nouvel essai automatique. Les modifications sont enregistrées sur cet appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動的に再試行します。変更はこのデバイスに保存されています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma nova tentativa será feita automaticamente. As alterações são salvas neste dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将自动重试。更改已保存在此设备上。"
          }
        }
      }
    },
    "You've scanned a QR code with authentication tokens. Would you like to import them?": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben einen QR-Code mit Authentifizierungs-Codes gescannt. Möchten Sie sie importieren?"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Has escaneado un código QR con códigos de autenticación. ¿Quieres importarlos?"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez scanné un QR code contenant des codes d'authentification. Voulez-vous les importer ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証コードを含む QR コードを読み取りました。読み込みますか？"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você escaneou um QR code com códigos de autenticação. Deseja importá-los?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你扫描的二维码中包含验证码，要导入吗？"
          }
        }
      }
    },
    "Your accounts, protected on device.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Konten, geschützt auf Ihrem Gerät."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus cuentas, protegidas en tu dispositivo."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos comptes, protégés sur votre appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのアカウントを、端末内で守ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas contas, protegidas no seu dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的账户，在设备上得到保护。"
