            "value": "コードの詳細"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Detalhes do código"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户详情"
          }
        }
      }
    },
    "Tokens Already Exist": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Codes bereits vorhanden"
          }
        },
        "es-ES": {
