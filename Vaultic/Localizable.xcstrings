    "Please enter a valid Base32 secret key (letters A-Z, numbers 2-7, minimum 16 characters).": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte geben Sie einen gültigen Base32-Schlüssel ein (Buchstaben A-Z, Ziffern 2-7, mindestens 16 Zeichen)."
          }
        },
        "es-ES": {
          "stringUnit": {
