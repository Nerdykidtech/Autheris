            "value": "Les codes existent déjà"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードはすでにあります"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os códigos já existem"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户已存在"
          }
        }
      }
    },
    "Tokens are stored only on this device.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Tokens werden nur auf diesem Gerät gespeichert."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tokens se guardan solo en este dispositivo."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jetons sont stockés uniquement sur cet appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トークンはこのデバイスにのみ保存されています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os tokens são armazenados apenas neste dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "令牌仅存储在此设备上。"
          }
        }
      }
    },
    "Tokens live in the device Keychain, protected by your passcode and Face ID / Touch ID.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Codes liegen im Schlüsselbund des Geräts, geschützt durch Ihren Gerätecode und Face ID / Touch ID."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Los códigos viven en el llavero del dispositivo, protegidos por tu código de acceso y Face ID / Touch ID."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Les codes résident dans le trousseau de l'appareil, protégés par votre code et Face ID / Touch ID."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードは端末のキーチェーンに保存され、パスコードと Face ID / Touch ID で保護されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os códigos ficam no Keychain do dispositivo, protegidos pelo seu código de acesso e por Face ID / Touch ID."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户保存在设备的钥匙串中，由你的密码和 Face ID / Touch ID 保护。"
          }
        }
      }
    },
    "Tokens stay on this device either way. Before deleting from iCloud, turn off iCloud Sync on your other devices — any device that still has it on will upload its tokens again.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tokens bleiben in jedem Fall auf diesem Gerät. Deaktiviere vor dem Löschen aus iCloud die iCloud-Synchronisierung auf deinen anderen Geräten – jedes Gerät, auf dem sie noch aktiv ist, lädt seine Tokens erneut hoch."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tokens se quedan en este dispositivo en cualquier caso. Antes de eliminarlos de iCloud, desactiva la sincronización con iCloud en tus otros dispositivos: cualquier dispositivo que la tenga activada volverá a subir sus tokens."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jetons restent sur cet appareil dans tous les cas. Avant de les supprimer d’iCloud, désactivez la synchronisation iCloud sur vos autres appareils : tout appareil sur lequel elle reste activée enverra à nouveau ses jetons."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どちらの場合もトークンはこのデバイスに残ります。iCloud から削除する前に、ほかのデバイスで iCloud 同期をオフにしてください。同期がオンのままのデバイスは、トークンを再びアップロードします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os tokens permanecem neste dispositivo de qualquer forma. Antes de excluir do iCloud, desative a sincronização com o iCloud nos seus outros dispositivos — qualquer dispositivo que ainda a tenha ativada enviará seus tokens novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无论哪种方式，令牌都会保留在此设备上。从 iCloud 删除之前，请先在你的其他设备上关闭 iCloud 同步——仍开启同步的设备会再次上传其令牌。"
          }
        }
      }
    },
