    "Could not create the encrypted backup.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die verschlüsselte Sicherung konnte nicht erstellt werden."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo crear la copia cifrada."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de créer la sauvegarde chiffrée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗号化バックアップを作成できませんでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível criar o backup criptografado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法创建加密备份。"
          }
        }
      }
    },
    "Could not parse QR code. It may not be a valid OTP QR code.\n\nCommon formats:\n- otpauth://totp/...\n- otpauth://hotp/...\n- Base32 secret key\n- Export format (multiple tokens)\n\nPlease enter the details manually.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "QR-Code konnte nicht gelesen werden. Möglicherweise ist es kein gültiger OTP-QR-Code.\n\nÜbliche Formate:\n- otpauth://totp/...\n- otpauth://hotp/...\n- Base32-Schlüssel\n- Exportformat (mehrere Codes)\n\nBitte geben Sie die Daten manuell ein."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo interpretar el código QR. Puede que no sea un QR OTP válido.\n\nFormatos habituales:\n- otpauth://totp/...\n- otpauth://hotp/...\n- Clave secreta Base32\n- Formato de exportación (varios códigos)\n\nIntroduce los datos manualmente."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire le QR code. Ce n'est peut-être pas un QR code OTP valide.\n\nFormats courants :\n- otpauth://totp/...\n- otpauth://hotp/...\n- Clé secrète Base32\n- Format d'export (plusieurs codes)\n\nSaisissez les informations manuellement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "QR コードを読み取れませんでした。有効な OTP QR コードではない可能性があります。\n\n主な形式:\n- otpauth://totp/...\n- otpauth://hotp/...\n- Base32 のシークレットキー\n- エクスポート形式（複数のコード）\n\n手入力で登録してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o QR code. Ele pode não ser um QR code OTP válido.\n\nFormatos comuns:\n- otpauth://totp/...\n- otpauth://hotp/...\n- Chave secreta Base32\n- Formato de exportação (vários códigos)\n\nInforme os dados manualmente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法解析二维码，它可能不是有效的 OTP 二维码。\n\n常见格式：\n- otpauth://totp/...\n- otpauth://hotp/...\n- Base32 密钥\n- 导出格式（多个账户）\n\n请手动输入信息。"
          }
        }
      }
    },
    "Could not parse the import data. The QR code may be corrupted or in an unsupported format.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Importdaten konnten nicht gelesen werden. Der QR-Code ist möglicherweise beschädigt oder hat ein nicht unterstütztes Format."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron interpretar los datos de importación. Puede que el código QR esté dañado o tenga un formato no admitido."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire les données d'import. Le QR code est peut-être corrompu ou dans un format non pris en charge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込みデータを解析できませんでした。QR コードが破損しているか、対応していない形式の可能性があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler os dados da importação. O QR code pode estar corrompido ou em um formato não aceito."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法解析导入数据。二维码可能已损坏，或使用了不支持的格式。"
          }
        }
      }
    },
    "Could not parse this Google Authenticator export.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Google-Authenticator-Export konnte nicht gelesen werden."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo interpretar esta exportación de Google Authenticator."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire cet export Google Authenticator."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Google Authenticator のエクスポートを解析できませんでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler esta exportação do Google Authenticator."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法解析这个 Google Authenticator 导出文件。"
          }
        }
      }
    },
    "Could not parse this Google Authenticator export. Make sure the QR or image is clear and complete, or try exporting again from Google Authenticator.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Google-Authenticator-Export konnte nicht gelesen werden. Achten Sie darauf, dass QR-Code oder Bild scharf und vollständig sind, oder exportieren Sie erneut aus Google Authenticator."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo interpretar esta exportación de Google Authenticator. Comprueba que el QR o la imagen se vean completos y nítidos, o vuelve a exportarla desde Google Authenticator."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire cet export Google Authenticator. Vérifiez que le QR code ou l'image est net et complet, ou relancez l'export depuis Google Authenticator."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Google Authenticator のエクスポートを解析できませんでした。QR コードや画像が鮮明で全体が写っているか確認するか、Google Authenticator で再エクスポートしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler esta exportação do Google Authenticator. Verifique se o QR code ou a imagem está nítido e completo, ou exporte novamente no Google Authenticator."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法解析这个 Google Authenticator 导出文件。请确认二维码或图片清晰完整，或重新从 Google Authenticator 导出。"
          }
        }
      }
    },
