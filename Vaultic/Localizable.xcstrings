    "You've scanned a QR code with authentication tokens. Would you like to import them?": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sie haben einen QR-Code mit Authentifizierungs-Codes gescannt. Möchten Sie sie importieren?"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Has escaneado un código QR con códigos de autenticación. ¿Quieres importarlos?"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous avez scanné un QR code contenant des codes d'authentification. Voulez-vous les importer ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "認証コードを含む QR コードを読み取りました。読み込みますか？"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Você escaneou um QR code com códigos de autenticação. Deseja importá-los?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你扫描的二维码中包含验证码，要导入吗？"
          }
        }
      }
    },
    "You've scanned an OTP QR code. Would you like to add this authentication token to your vault?": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sie haben einen OTP-QR-Code gescannt. Möchten Sie diesen Authentifizierungs-Code hinzufügen?"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Has escaneado un código QR OTP. ¿Quieres añadir este código de autenticación a tu lista?"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous avez scanné un QR code OTP. Voulez-vous ajouter ce code d'authentification à votre liste ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "OTP QR コードを読み取りました。この認証コードを追加しますか？"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Você escaneou um QR code OTP. Deseja adicionar este código de autenticação à sua lista?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你扫描了一个 OTP 二维码，要把这个验证码添加到账户列表吗？"
          }
        }
      }
    },
    "Your accounts, protected on device.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ihre Konten, geschützt auf Ihrem Gerät."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tus cuentas, protegidas en tu dispositivo."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vos comptes, protégés sur votre appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "あなたのアカウントを、端末内で守ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Suas contas, protegidas no seu dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你的账户，在设备上得到保护。"
          }
        }
      }
    },
    "Your edits have not been saved.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ihre Änderungen wurden nicht gesichert."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tus cambios no se han guardado."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "needs_review",
