        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你对这个设置密钥的更改尚未保存。"
          }
        }
      }
    },
    "Your tokens have been backed up successfully.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Codes wurden erfolgreich gesichert."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus códigos se han guardado correctamente."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos codes ont été sauvegardés avec succès."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードをバックアップしました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
