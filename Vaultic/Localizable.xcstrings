    "Sync with iCloud": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mit iCloud synchronisieren"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sincronizar con iCloud"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Synchroniser avec iCloud"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iCloud と同期"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sincronizar com o iCloud"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "与 iCloud 同步"
          }
        }
      }
    },
    "Syncs your tokens through your private iCloud database. Secret keys are end-to-end encrypted and are never stored in a readable form.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Synchronisiert Ihre Codes über Ihre private iCloud-Datenbank. Schlüssel sind Ende-zu-Ende-verschlüsselt und werden nie im lesbaren Zustand gespeichert."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sincroniza tus códigos con tu base de datos privada de iCloud. Las claves secretas se cifran de extremo a extremo y nunca se guardan en un formato legible."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Synchronise vos codes via votre base iCloud privée. Les clés secrètes sont chiffrées de bout en bout et ne sont jamais stockées sous une forme lisible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "プライベートな iCloud データベースを通じてコードを同期します。シークレットキーはエンドツーエンドで暗号化され、読める形で保存されることはありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sincroniza seus códigos pelo seu banco de dados privado do iCloud. As chaves secretas são criptografadas de ponta a ponta e nunca ficam gravadas em forma legível."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "通过你的私人 iCloud 数据库同步账户。密钥经过端到端加密，绝不会以可读形式保存。"
          }
        }
      }
    },
    "Tap a version to show or hide release notes. Newest first.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tippen Sie auf eine Version, um die Versionshinweise ein- oder auszublenden. Neueste zuerst."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toca una versión para ver u ocultar sus notas. La más reciente, primero."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Touchez une version pour afficher ou masquer ses notes. La plus récente en premier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "バージョンをタップするとリリースノートが表示・非表示になります。新しい順です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toque em uma versão para mostrar ou ocultar as notas. Mais recente primeiro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "点按版本号即可展开或收起更新说明，最新的在最前。"
          }
        }
      }
    },
