    "Syncs your tokens through your private iCloud database. Secret keys are end-to-end encrypted and are never stored in a readable form.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisiert Ihre Codes über Ihre private iCloud-Datenbank. Schlüssel sind Ende-zu-Ende-verschlüsselt und werden nie im lesbaren Zustand gespeichert."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza tus códigos con tu base de datos privada de iCloud. Las claves secretas se cifran de extremo a extremo y nunca se guardan en un formato legible."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronise vos codes via votre base iCloud privée. Les clés secrètes sont chiffrées de bout en bout et ne sont jamais stockées sous une forme lisible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライベートな iCloud データベースを通じてコードを同期します。シークレットキーはエンドツーエンドで暗号化され、読める形で保存されることはありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza seus códigos pelo seu banco de dados privado do iCloud. As chaves secretas são criptografadas de ponta a ponta e nunca ficam gravadas em forma legível."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过你的私人 iCloud 数据库同步账户。密钥经过端到端加密，绝不会以可读形式保存。"
          }
        }
      }
    },
    "Tap a version to show or hide release notes. Newest first.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf eine Version, um die Versionshinweise ein- oder auszublenden. Neueste zuerst."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una versión para ver u ocultar sus notas. La más reciente, primero."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une version pour afficher ou masquer ses notes. La plus récente en premier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョンをタップするとリリースノートが表示・非表示になります。新しい順です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em uma versão para mostrar ou ocultar as notas. Mais recente primeiro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按版本号即可展开或收起更新说明，最新的在最前。"
          }
        }
      }
    },
    "Tap to reveal the setup key": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen, um den Einrichtungsschlüssel anzuzeigen"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para mostrar la clave de configuración"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez pour afficher la clé de configuration"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップしてセットアップキーを表示"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para mostrar a chave de configuração"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按以显示设置密钥"
          }
        }
      }
    },
    "That verification-code link isn't in the expected otpauth format.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Link hat nicht das erwartete otpauth-Format."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese enlace de verificación no tiene el formato otpauth esperado."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce lien de code de vérification n'est pas au format otpauth attendu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この確認コードのリンクは、想定された otpauth 形式ではありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse link de código de verificação não está no formato otpauth esperado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个验证码链接不是预期的 otpauth 格式。"
          }
        }
      }
    },
    "The Autheris CloudKit schema has not been deployed yet.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Das CloudKit-Schema von Autheris wurde noch nicht bereitgestellt."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El esquema de CloudKit de Autheris aún no se ha implementado."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Le schéma CloudKit d’Autheris n’a pas encore été déployé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Autheris の CloudKit スキーマはまだデプロイされていません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O esquema do CloudKit do Autheris ainda não foi implantado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Autheris 的 CloudKit 架构尚未部署。"
          }
        }
      }
    },
    "The codes stored on this device can't be read by this version of Autheris. They haven't been changed. You can set them aside and start over, then restore a backup from Settings — or, with iCloud sync on, let your other devices bring them back.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die auf diesem Gerät gespeicherten Codes können von dieser Version von Autheris nicht gelesen werden. Sie wurden nicht verändert. Sie können sie beiseitelegen und neu beginnen und dann eine Sicherung in den Einstellungen wiederherstellen – oder sie bei aktivierter iCloud-Synchronisierung von Ihren anderen Geräten zurückholen lassen."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión de Autheris no puede leer los códigos guardados en este dispositivo. No se han modificado. Puedes apartarlos y empezar de nuevo, y después restaurar una copia desde Ajustes o, con la sincronización con iCloud activada, dejar que tus otros dispositivos los recuperen."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version d'Autheris ne peut pas lire les codes enregistrés sur cet appareil. Ils n'ont pas été modifiés. Vous pouvez les mettre de côté et repartir de zéro, puis restaurer une sauvegarde depuis Réglages, ou, avec la synchronisation iCloud activée, laisser vos autres appareils les rapatrier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末に保存されているコードは、このバージョンの Autheris では読み取れません。コードは変更されていません。コードを別に保管してやり直し、設定からバックアップを復元できます。iCloud 同期がオンなら、ほかの端末からコードを戻すこともできます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versão do Autheris não consegue ler os códigos salvos neste dispositivo. Eles não foram alterados. Você pode deixá-los de lado e recomeçar, depois restaurar um backup em Ajustes — ou, com a sincronização com o iCloud ativada, deixar que seus outros dispositivos os tragam de volta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本的 Autheris 无法读取存储在此设备上的验证码。它们没有被更改。你可以将它们另行保存并重新开始，然后在“设置”中恢复备份；如果开启了 iCloud 同步，也可以让其他设备将验证码同步回来。"
          }
        }
      }
    },
    "The setup key in that link isn't a valid Base32 secret.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Einrichtungsschlüssel in diesem Link ist kein gültiges Base32-Secret."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave de configuración de ese enlace no es un secreto Base32 válido."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé de configuration de ce lien n'est pas un secret Base32 valide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリンクのセットアップキーは有効な Base32 シークレットではありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de configuração nesse link não é um segredo Base32 válido."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接中的设置密钥不是有效的 Base32 密钥。"
          }
        }
      }
    },
    "The unreadable codes couldn't be set aside, so nothing was changed.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die nicht lesbaren Codes konnten nicht beiseitegelegt werden, daher wurde nichts verändert."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron apartar los códigos ilegibles, así que no se ha cambiado nada."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Les codes illisibles n'ont pas pu être mis de côté ; rien n'a donc été modifié."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取れないコードを別に保管できなかったため、何も変更されていません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível deixar de lado os códigos ilegíveis, então nada foi alterado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法另行保存无法读取的验证码，因此未做任何更改。"
          }
        }
      }
    },
    "The unreadable codes stay on this device, kept apart from the codes Autheris uses, and Autheris starts with none. Apple Watch keeps its codes until the next change here.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die nicht lesbaren Codes bleiben auf diesem Gerät, getrennt von den Codes, die Autheris verwendet, und Autheris beginnt ohne Codes. Die Apple Watch behält ihre Codes bis zur nächsten Änderung hier."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Los códigos ilegibles se quedan en este dispositivo, separados de los que usa Autheris, y Autheris empieza sin ninguno. El Apple Watch conserva sus códigos hasta el próximo cambio aquí."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Les codes illisibles restent sur cet appareil, à l'écart des codes qu'utilise Autheris, et Autheris repart sans aucun code. L'Apple Watch conserve ses codes jusqu'à la prochaine modification ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取れないコードは、Autheris が使用するコードとは別にこの端末に残り、Autheris はコードがない状態から始まります。Apple Watch のコードは、ここで次に変更があるまでそのまま残ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os códigos ilegíveis ficam neste dispositivo, separados dos códigos que o Autheris usa, e o Autheris começa sem nenhum. O Apple Watch mantém seus códigos até a próxima alteração aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取的验证码会保留在此设备上，与 Autheris 使用的验证码分开存放，Autheris 将从零开始。Apple Watch 上的验证码会保留到此处下次更改为止。"
          }
        }
      }
    },
    "These codes will be permanently removed from this device. This cannot be undone.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Codes werden endgültig von diesem Gerät entfernt. Das kann nicht rückgängig gemacht werden."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos códigos se eliminarán de forma permanente de este dispositivo. Esta acción no se puede deshacer."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces codes seront définitivement supprimés de cet appareil. Cette action est irréversible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのコードはこの端末から完全に削除されます。この操作は取り消せません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes códigos serão removidos em definitivo deste dispositivo. Isso não pode ser desfeito."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些账户将从本设备彻底删除，此操作无法撤销。"
          }
        }
      }
    },
    "This backup couldn't be read.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Sicherung konnte nicht gelesen werden."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer esta copia de seguridad."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire cette sauvegarde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバックアップを読み込めませんでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler este backup."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取此备份。"
          }
        }
      }
    },
    "This backup is encrypted. Enter the password used when it was created.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Sicherung ist verschlüsselt. Geben Sie das Passwort ein, das beim Erstellen verwendet wurde."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia está cifrada. Introduce la contraseña que usaste al crearla."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette sauvegarde est chiffrée. Saisissez le mot de passe utilisé lors de sa création."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバックアップは暗号化されています。作成時に設定したパスワードを入力してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este backup é criptografado. Digite a senha usada quando ele foi criado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个备份已加密，请输入创建时所用的密码。"
          }
        }
      }
    },
    "This backup uses an unsupported format version.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Backup verwendet eine nicht unterstützte Formatversion."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia de seguridad usa una versión de formato no compatible."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette sauvegarde utilise une version de format non prise en charge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバックアップはサポートされていない形式のバージョンを使用しています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este backup usa uma versão de formato não compatível."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此备份使用了不受支持的格式版本。"
          }
        }
      }
    },
    "This build is not configured for iCloud. Add the iCloud capability to the Autheris target.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Build ist nicht für iCloud konfiguriert. Füge dem Autheris-Target die iCloud-Fähigkeit hinzu."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta compilación no está configurada para iCloud. Añade la capacidad de iCloud al target de Autheris."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version n’est pas configurée pour iCloud. Ajoutez la fonctionnalité iCloud à la cible Autheris."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドは iCloud 用に構成されていません。Autheris ターゲットに iCloud 機能を追加してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta compilação não está configurada para o iCloud. Adicione o recurso iCloud ao target do Autheris."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本未配置 iCloud。请为 Autheris 目标添加 iCloud 功能。"
          }
        }
      }
    },
    "This build is not entitled to the %@ iCloud container.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Build ist nicht für den iCloud-Container %@ berechtigt."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta compilación no tiene permiso para el contenedor de iCloud %@."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version n’a pas le droit d’accéder au conteneur iCloud %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドには iCloud コンテナ %@ の使用権限がありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta compilação não tem permissão para o contêiner do iCloud %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本无权使用 iCloud 容器 %@。"
          }
        }
      }
    },
    "This code changes only when you ask for the next one. Raise the counter if the service has moved ahead of it — for instance after a code was used on a device that no longer has this account.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Code ändert sich nur, wenn Sie den nächsten anfordern. Erhöhen Sie den Zähler, wenn der Dienst voraus ist – etwa nachdem ein Code auf einem Gerät verwendet wurde, das dieses Konto nicht mehr hat."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código solo cambia cuando pides el siguiente. Aumenta el contador si el servicio se ha adelantado; por ejemplo, después de usar un código en un dispositivo que ya no tiene esta cuenta."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code ne change que lorsque vous demandez le suivant. Augmentez le compteur si le service est en avance — par exemple après avoir utilisé un code sur un appareil qui n’a plus ce compte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコードは、次のコードを要求したときだけ変わります。サービスのカウンターが進んでいる場合はカウンターを増やしてください。たとえば、このアカウントがない別の端末でコードを使用した後などです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código só muda quando você pede o próximo. Aumente o contador se o serviço estiver à frente — por exemplo, depois de usar um código em um dispositivo que não tem mais esta conta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此代码仅在你请求下一个时才更改。如果服务的计数器已经前进，请提高计数器——例如，在不再拥有此账户的设备上使用过代码之后。"
          }
        }
      }
    },
    "This export is too large for a single QR code. Use Backup from the menu to transfer your tokens as a file instead.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Export ist zu groß für einen einzelnen QR-Code. Nutzen Sie stattdessen Sicherung im Menü, um Ihre Codes als Datei zu übertragen."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta exportación es demasiado grande para un solo código QR. Usa Copia de seguridad en el menú para pasar tus códigos como archivo."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet export est trop volumineux pour un seul QR code. Utilisez Sauvegarde dans le menu pour transférer vos codes sous forme de fichier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この書き出しは 1 つの QR コードには大きすぎます。代わりにメニューの「バックアップ」でファイルとして移してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta exportação é grande demais para um único QR code. Use Backup no menu para transferir seus códigos como arquivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个导出内容太大，一个二维码装不下。请改用菜单里的“备份”，以文件方式转移账户。"
          }
        }
      }
    },
    "This file holds every setup key as plain text. Anyone who gets a copy can generate your codes. An encrypted backup is safer.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei enthält alle Einrichtungsschlüssel als Klartext. Wer eine Kopie erhält, kann deine Codes erzeugen. Ein verschlüsseltes Backup ist sicherer."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo contiene todas las claves de configuración como texto sin cifrar. Cualquiera que obtenga una copia puede generar tus códigos. Una copia de seguridad cifrada es más segura."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier contient toutes les clés de configuration en clair. Toute personne qui en obtient une copie peut générer vos codes. Une sauvegarde chiffrée est plus sûre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルにはすべてのセットアップキーが平文で含まれます。コピーを入手した人は誰でもあなたのコードを生成できます。暗号化されたバックアップの方が安全です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo guarda todas as chaves de configuração em texto simples. Qualquer pessoa que tiver uma cópia pode gerar seus códigos. Um backup criptografado é mais seguro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件以明文形式保存所有设置密钥。任何获得副本的人都能生成你的验证码。加密备份更安全。"
          }
        }
      }
    },
    "This file isn't a supported Aegis, andOTP, or 2FAS export.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei ist kein unterstützter Export von Aegis, andOTP oder 2FAS."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo no es una exportación compatible de Aegis, andOTP o 2FAS."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier n'est pas un export Aegis, andOTP ou 2FAS pris en charge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは対応している Aegis、andOTP、2FAS のエクスポートではありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo não é uma exportação compatível do Aegis, andOTP ou 2FAS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件不是受支持的 Aegis、andOTP 或 2FAS 导出文件。"
          }
        }
      }
    },
    "This file isn't a valid encrypted Autheris backup.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei ist kein gültiges verschlüsseltes Autheris-Backup."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo no es una copia de seguridad cifrada válida de Autheris."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier n’est pas une sauvegarde Autheris chiffrée valide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは有効な暗号化済み Autheris バックアップではありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
