          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户已成功备份。"
          }
        }
      }
    },
    "Your tokens have been restored from the backup.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Codes wurden aus der Sicherung wiederhergestellt."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus códigos se han restaurado desde la copia de seguridad."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos codes ont été restaurés à partir de la sauvegarde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードをバックアップから復元しました。"
          }
        },
        "pt-BR": {
