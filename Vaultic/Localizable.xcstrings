    "Encrypted backups (.autheris) are protected with your password using AES-GCM. Unencrypted backups are plain JSON.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verschlüsselte Sicherungen (.autheris) werden mit Ihrem Passwort per AES-GCM geschützt. Unverschlüsselte Sicherungen sind reines JSON."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las copias cifradas (.autheris) se protegen con tu contraseña mediante AES-GCM. Las copias sin cifrar son JSON sin más."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les sauvegardes chiffrées (.autheris) sont protégées par votre mot de passe avec AES-GCM. Les sauvegardes non chiffrées sont du JSON en clair."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "暗号化バックアップ（.autheris）は AES-GCM でパスワードにより保護されます。非暗号化バックアップは暗号化されていない JSON です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os backups criptografados (.autheris) são protegidos com sua senha usando AES-GCM. Backups sem criptografia são JSON simples."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "加密备份（.autheris）使用 AES-GCM 和你的密码保护。未加密备份就是普通 JSON。"
          }
        }
      }
    },
    "Enter Backup Password": {
      "localizations": {
