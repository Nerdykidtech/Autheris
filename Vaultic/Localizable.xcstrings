    "Imports unencrypted Aegis, andOTP, and 2FAS backup files. Deleted codes stay recoverable on this device for %lld days.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Importiert unverschlüsselte Sicherungsdateien von Aegis, andOTP und 2FAS. Gelöschte Codes bleiben auf diesem Gerät %lld Tage lang wiederherstellbar."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Importa archivos de copia sin cifrar de Aegis, andOTP y 2FAS. Los códigos eliminados se pueden recuperar en este dispositivo durante %lld días."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Importe les fichiers de sauvegarde non chiffrés d'Aegis, andOTP et 2FAS. Les codes supprimés restent récupérables sur cet appareil pendant %lld jours."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aegis、andOTP、2FAS の非暗号化バックアップを読み込めます。削除したコードは %lld 日間この端末で復元できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Importa arquivos de backup sem criptografia do Aegis, andOTP e 2FAS. Os códigos excluídos ficam recuperáveis neste dispositivo por %lld dias."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "可导入 Aegis、andOTP 和 2FAS 的未加密备份文件。删除的账户会在本设备上保留 %lld 天，可随时恢复。"
          }
        }
      }
    },
