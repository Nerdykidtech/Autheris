          }
        }
      }
    },
    "Point your camera at a QR code, or upload a screenshot. Google Authenticator export (otpauth-migration) codes work too.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Richten Sie die Kamera auf einen QR-Code oder laden Sie einen Screenshot hoch. Export-Codes von Google Authenticator (otpauth-migration) funktionieren ebenfalls."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunta la cámara a un código QR o sube una captura. Los códigos de exportación de Google Authenticator (otpauth-migration) también funcionan."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pointez la caméra vers un QR code ou importez une capture d'écran. Les codes d'export Google Authenticator (otpauth-migration) fonctionnent aussi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラを QR コードに向けるか、スクリーンショットを読み込んでください。Google Authenticator のエクスポート（otpauth-migration）コードにも対応しています。"
