    "Choose a password. You'll need it to restore this backup.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie ein Passwort. Sie benötigen es, um diese Sicherung wiederherzustellen."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una contraseña. La necesitarás para restaurar esta copia."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un mot de passe. Il vous faudra pour restaurer cette sauvegarde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
