          "stringUnit": {
            "state": "translated",
            "value": "%@ ya está en Autheris."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est déjà dans Autheris."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はすでに Autheris にあります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ já está no Autheris."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已在 Autheris 中。"
