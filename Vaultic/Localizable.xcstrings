    },
    "This export is too large for a single QR code. Use Backup from the menu to transfer your tokens as a file instead.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieser Export ist zu groß für einen einzelnen QR-Code. Nutzen Sie stattdessen Sicherung im Menü, um Ihre Codes als Datei zu übertragen."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta exportación es demasiado grande para un solo código QR. Usa Copia de seguridad en el menú para pasar tus códigos como archivo."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cet export est trop volumineux pour un seul QR code. Utilisez Sauvegarde dans le menu pour transférer vos codes sous forme de fichier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この書き出しは 1 つの QR コードには大きすぎます。代わりにメニューの「バックアップ」でファイルとして移してください。"
          }
        },
        "pt-BR": {
