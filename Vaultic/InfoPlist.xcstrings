    "NSCameraUsageDescription": {
      "comment": "Privacy - Camera Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kamerazugriff ist erforderlich, um QR-Codes für die 2FA-Authentifizierung zu scannen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Camera access is required to scan ​QR codes for 2​FA tokens"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se necesita acceso a la cámara para escanear códigos QR de autenticación 2FA."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L'accès à la caméra est nécessaire pour scanner des QR codes d'authentification 2FA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "2FA 認証の QR コードを読み取るにはカメラへのアクセスが必要です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O acesso à câmera é necessário para escanear QR codes de autenticação 2FA."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "扫描 2FA 认证二维码需要相机权限。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "comment": "Privacy - Face ID Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autheris verwendet Face ID, um Ihre Codes zu entsperren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Autheris uses Face ID to unlock your tokens."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autheris usa Face ID para desbloquear tus códigos."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autheris utilise Face ID pour déverrouiller vos codes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autheris は Face ID でコードのロックを解除します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Autheris usa o Face ID para desbloquear seus códigos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autheris 使用 Face ID 解锁你的账户。"
          }
        }
      }
    }
  },
  "version": "1.3"
