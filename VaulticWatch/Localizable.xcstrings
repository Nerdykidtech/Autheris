    "Add a code in Autheris on your iPhone and it will appear here." : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie in Autheris auf Ihrem iPhone einen Code hinzu, und er erscheint hier."
